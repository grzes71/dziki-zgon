  "form_plan": {
    "form_type": "A-B-A",
    "primary_theme_description": "A weary stepwise descent from E5 down to A4 with a two-step comic silence before a G#-A limp back into the loop; dry thuds on the downbeats and a plodding root-fifth bass give it a mock-heroic swagger.",
    "contrast_theme_description": null,
    "sections": [
      {
        "section_id": "A1",
        "pattern_id": "patA",
        "role": "theme",
        "variation_of": null,
        "description": "First statement of the descending 'the hero has fallen' motif, ending on a tiny G#-A stumble."
      },
      {
        "section_id": "A1b",
        "pattern_id": "patA2",
        "role": "theme_variation",
        "variation_of": null,
        "description": "The descent extended all the way down to E4, so the phrase empties out and hands over to the middle section."
      },
      {
        "section_id": "B",
        "pattern_id": "patB",
        "role": "bridge",
        "variation_of": null,
        "description": "Contrast: the melody climbs instead of falling, pleading upward over a Dm-E-Am-E bass, absurdly hopeful."
      },
      {
        "section_id": "B2",
        "pattern_id": "patB2",
        "role": "bridge_development",
        "variation_of": null,
        "description": "The climb reaches an over-earnest G5 peak, then deflates stepwise back to the dominant with a chromatic bass descent."
      },
      {
        "section_id": "A2",
        "pattern_id": "patA3",
        "role": "theme_reprise",
        "variation_of": null,
        "description": "Return of the theme, but the tail is lopped off and left hanging on G4 with a VI-VII bass, so the joke never quite lands."
      },
      {
        "section_id": "A2b",
        "pattern_id": "patA2",
        "role": "theme_variation",
        "variation_of": null,
        "description": "Second reprise of the full descent to consolidate the hook before the ending."
      },
      {
        "section_id": "Coda",
        "pattern_id": "patC",
        "role": "coda",
        "variation_of": null,
        "description": "Final collapse: the lament descends once more, tips over a G# leading tone, and holds a dying A4 over a last A minor thud."
      }
    ]
